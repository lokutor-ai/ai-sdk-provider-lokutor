{
  "name": "@lokutor/ai-sdk-provider",
  "version": "0.1.0",
  "description": "Lokutor provider for the Vercel AI SDK: text-to-speech and speech-to-text",
  "license": "MIT",
  "author": "Lokutor AI",
  "homepage": "https://docs.lokutor.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokutor-ai/ai-sdk-provider-lokutor.git"
  },
  "bugs": "https://github.com/lokutor-ai/ai-sdk-provider-lokutor/issues",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "lokutor",
    "tts",
    "stt",
    "speech",
    "transcription",
    "voice"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.35"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.162",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "zod": "^4.6.7"
  }
}
